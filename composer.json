{
    "name": "synolia/sylius-scheduler-command-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "scheduler",
        "command"
    ],
    "description": "Scheduler Command Plugin.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-json": "*",
        "dragonmantank/cron-expression": "^3.4",
        "sylius/sylius": "^2.2",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/lock": "^7.4 || ^8.0",
        "symfony/polyfill-intl-icu": "^1.26",
        "symfony/process": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpmd/phpmd": "^2.15.0 || ^3.0",
        "phpro/grumphp": "^2.9",
        "phpspec/phpspec": "^8.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "2.1.32",
        "phpstan/phpstan-doctrine": "2.0.12",
        "phpstan/phpstan-strict-rules": "2.0.7",
        "phpstan/phpstan-webmozart-assert": "2.0.0",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^2.0",
        "seld/jsonlint": "^1.11",
        "slevomat/coding-standard": "^8.7",
        "squizlabs/php_codesniffer": "^3.11",
        "sylius-labs/coding-standard": "^4.3",
        "sylius/test-application": "^2.2@alpha",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/debug-bundle": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/intl": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symplify/easy-coding-standard": "^12.5"
    },
    "suggest": {
        "lorisleiva/cron-translator": "Allow showing humanized and translated cron expression."
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Synolia\\SyliusSchedulerCommandPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Synolia\\SyliusSchedulerCommandPlugin\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": true
        }
    },
    "scripts": {
        "ecs": "ecs check -c ruleset/ecs.php --ansi --clear-cache",
        "fix-ecs": "@ecs --fix",
        "phpmd": "phpmd src ansi ruleset/.php_md.xml",
        "phpstan": "phpstan analyse src -c ruleset/phpstan.neon",
        "phpunit": "phpunit tests/PHPUnit --colors=always",
        "tests": [
            "@ecs",
            "@phpmd",
            "@phpstan",
            "@phpunit"
        ],
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    },
    "conflict": {
        "sylius/test-application": "v2.0.0-ALPHA.1"
    }
}
